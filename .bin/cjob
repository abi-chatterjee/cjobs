            return None

        spec = ask("schedule", st.get("schedule", "daily 03:00"), check_spec)
        canon, entries = spec_holder["parsed"]

        max_turns = ask("max turns", str(st.get("max_turns", 25)),
                        lambda v: None if v.isdigit() and int(v) > 0
                        else "a positive integer")
        budget = ask("max budget USD", str(st.get("max_budget_usd", 3)),
                     lambda v: None if re.match(r"^\d+(\.\d+)?$", v)
                     else "a number")
        timeout = ask("timeout seconds (0 disables)",
                      str(st.get("timeout_seconds", 1800)),
                      lambda v: None if v.isdigit() else "an integer")
        retention = ask("log retention days (0 disables)",
                        str(st.get("log_retention_days", 30)),
                        lambda v: None if v.isdigit() else "an integer")
        path_extra = input("  %s%s: " % (
            "extra PATH entries (colon-separated, blank for none)",
            dim(" [%s]" % st.get("path_extra", "")))).strip() \
            or st.get("path_extra", "")

        job = Job(name)
        try:
            os.makedirs(job.state_dir, exist_ok=True)
            os.makedirs(job.logs_dir, exist_ok=True)
            write_run_sh(job, {
                "JOB_NAME": name, "REPO_DIR": repo, "EXTRA_DIRS": [],
                "MODEL": model, "PERMISSION_MODE": mode, "MAX_TURNS": max_turns,
                "MAX_BUDGET_USD": budget, "ALLOWED_TOOLS": "",
                "DISALLOWED_TOOLS": "", "TIMEOUT_SECONDS": timeout,
                "LOG_RETENTION_DAYS": retention, "PATH_EXTRA": path_extra,
                "TOKEN_FILE": DEFAULT_TOKEN_FILE, "CLAUDE_BIN": DEFAULT_CLAUDE_BIN,
            }, template_name="run.sh.tmpl")
            shutil.copyfile(os.path.join(TEMPLATES, "prompt.md.tmpl"), job.prompt)
        except OSError as exc:
            return self.fail("scaffolding failed: %s" % exc)

        meta = job.meta()
        meta["created"] = datetime.datetime.now().isoformat(timespec="seconds")
        meta["enabled"] = False
        meta["schedule"] = {"spec": canon, "entries": entries}
        job.write_meta(meta)
        write_plist(job, entries)

        save_cli_state(dict(st, **{
            "last_runner": "claude",
            "repo_dir": repo, "model": model, "permission_mode": mode,
            "schedule": canon, "max_turns": int(max_turns),
            "max_budget_usd": float(budget), "timeout_seconds": int(timeout),
            "log_retention_days": int(retention), "path_extra": path_extra,
        }))

        print(green("\ncreated %s" % job.dir))
        print("  run.sh     %s" % job.run_sh)
        print("  prompt.md  %s" % job.prompt)
        print("  plist      %s %s" % (job.plist, dim("(written, not loaded)")))
        print(bold("\nbefore this job can work unattended:"))
        print("  1. Grant Full Disk Access to /bin/bash, or TCC will block reads of")
        print("     ~/Documents, ~/Desktop, ~/Downloads and iCloud Drive:")
        print("     " + FDA_HELP.replace("\n", "\n     "))
        print("  2. Write the task into prompt.md (opening it now).")
        print("  3. Test it: %s" % bold("cjob run %s" % name))
        print("  4. Activate it: %s" % bold("cjob enable %s" % name))
        print(dim("     (creation and activation are separate on purpose)"))
