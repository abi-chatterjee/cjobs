class Cjob(cmd.Cmd):
    prompt = "%s " % cyan("cjob>") if _TTY else "cjob> "
    intro = "\n".join([
        bold("cjob") + " — local scheduled Claude Code jobs",
        dim("type `help` for commands, `doctor` for a health check, `quit` to exit"),
    ])
    doc_header = "commands (type `help <cmd>`)"

    def __init__(self):
        super().__init__()
        self.rc = 0

    # ---- plumbing ----
    def fail(self, msg=None):
        if msg:
            err(msg)
        self.rc = 1

    def emptyline(self):
        return None

    def default(self, line):
        self.fail("unknown command: %s  (try `help`)" % line.split()[0])

    def _complete_job(self, text):
        return [j.name for j in list_jobs() if j.name.startswith(text)]

    # cmd.Cmd falls back to completedefault for any command without its own
    # complete_<cmd>, so this tab-completes job names everywhere.
    def completedefault(self, text, line, begidx, endidx):
        return self._complete_job(text)

    # ---- ls ----
    def do_ls(self, arg):
        """ls — list all jobs with schedule, model and last-run status."""
        jobs = list_jobs()
        if not jobs:
            print(dim("no jobs yet — run `new` to create one"))
            return
        rows = []
        for job in jobs:
            meta = job.meta()
            last = job.recent_runs(1)
            rec = last[0] if last else None
            enabled = meta.get("enabled") and agent_loaded(job.label)
            if meta.get("enabled") and not agent_loaded(job.label):
                on = yellow("stale")
            else:
                on = green("yes") if enabled else dim("no")
            when = dim("never")
            if rec:
                when = "%s %s" % (rec["date"][5:], rec["time"])
            running = job.locked_pid()
            name = job.name + (" " + yellow("*running*") if running else "")
            if meta.get("runner") == "jiva":
                engine = "jiva"
            else:
                engine = meta.get("model") or dim("?")
            rows.append([
                name, on, describe_schedule(meta), engine,
                when, fmt_exit(rec), fmt_cost(rec["total_cost_usd"] if rec else None),
            ])
        table(rows, ["JOB", "ON", "SCHEDULE", "RUNNER/MODEL", "LAST RUN", "EXIT", "LAST COST"])
        print(dim("\ncost is est. API-equivalent (Claude: Max plan quota; Jiva: only shown if you set a $/1M-token price)"))

    # ---- show ----
    def do_show(self, arg):
        """show <job> — full detail: config, repo, prompt, plist status, last runs."""
        job = get_job(shlex.split(arg)[0] if arg.strip() else "")
        if not job:
            return self.fail()
        cfg, meta = job.config(), job.meta()

        print(bold("\n%s" % job.name))
        print(dim("  " + job.dir))

        runner = cfg.get("RUNNER") or "claude"
        print(bold("\n  config (from run.sh)") + dim("  [runner: %s]" % runner))
        rows = []
        for key in config_keys_for(cfg):
            val = cfg.get(key, "")
            if isinstance(val, list):
                val = " ".join(val) if val else dim("<none>")
            elif val == "":
                val = dim("<empty>")
            chunks = _wrap_value(val)
            rows.append(["    " + key, chunks[0]])
            for extra in chunks[1:]:
                rows.append(["", extra])
        table(rows, ["    KEY", "VALUE"])

        if runner == "jiva":
            warn("  Jiva's --code mode has no workspace-boundary enforcement — its "
                 "file-write and shell tools can reach anywhere this user can, not "
                 "just REPO_DIR. Only use this runner where that's an acceptable risk.")
        else:
            auto = auto_mode_supported(cfg.get("MODEL", ""))
            if cfg.get("MODEL", "") in MODEL_ALIASES:
                warn("  MODEL is the alias %r — pin a full ID so behaviour and cost "
                     "don't drift on the next release" % cfg.get("MODEL"))
            if cfg.get("PERMISSION_MODE") == "auto":
                if auto is False:
                    warn("  permission mode `auto` with %s: unsupported — the job fails "
                         "at startup, not gracefully at runtime" % cfg.get("MODEL"))
                elif auto is None:
                    warn("  permission mode `auto` with an unrecognised model %r — "
                         "verify it supports auto mode" % cfg.get("MODEL"))
            if cfg.get("PERMISSION_MODE") == "bypassPermissions":
                warn("  permission mode `bypassPermissions` disables safety checks "
                     "entirely — only appropriate for a genuinely isolated repo")

        print(bold("\n  repo"))
        repo = cfg.get("REPO_DIR", "")
        info = git_info(repo)
        if not os.path.isdir(repo):
            print("    %s %s" % (red("MISSING"), repo))
        elif info:
            print("    %s  %s @ %s%s" % (repo, info["branch"], info["sha"],
                                         yellow(" (dirty)") if info["dirty"] else ""))
        else:
            print("    %s  %s" % (repo, yellow("not a git repo")))

        print(bold("\n  prompt") + dim("  (%s)" % job.prompt))
        try:
            with open(job.prompt) as fh:
                lines = fh.read().splitlines()
        except OSError:
            lines = []
        if not lines:
            print("    %s" % red("empty or missing"))
        for line in lines[:24]:
            print("    " + dim(line) if line.startswith("<!--") else "    " + line)
        if len(lines) > 24:
            print(dim("    ... %d more lines" % (len(lines) - 24)))

        print(bold("\n  schedule"))
        print("    spec     : %s" % describe_schedule(meta))
        print("    label    : %s" % job.label)
        print("    plist    : %s" % (job.plist if os.path.exists(job.plist)
                                     else dim("not written")))
        loaded = agent_loaded(job.label)
        state = green("loaded") if loaded else dim("not loaded")
        if meta.get("enabled") and not loaded:
            state = yellow("marked enabled in job.json but NOT loaded in launchd")
        elif loaded and not meta.get("enabled"):
            state = yellow("loaded in launchd but marked disabled in job.json")
        print("    launchd  : %s" % state)
        if loaded:
            rc, out, _ = launchctl("print", "%s/%s" % (DOMAIN, job.label))
            if rc == 0:
                for key in ("state =", "last exit code =", "runs =", "pid ="):
                    for line in out.splitlines():
                        if key in line:
                            print("    %s" % dim(line.strip()))
                            break

        pid = job.locked_pid()
        if pid:
            print("\n  %s currently running (pid %d)" % (yellow("●"), pid))

        print(bold("\n  last 5 runs"))
        runs = list(reversed(job.recent_runs(5)))
        if not runs:
            print(dim("    no runs yet"))
        else:
            table([["    %s %s" % (r["date"], r["time"]), fmt_exit(r),
                    fmt_dur(r["duration_seconds"]),
                    dim("—") if r["num_turns"] is None else str(r["num_turns"]),
                    fmt_cost(r["total_cost_usd"])] for r in runs],
                  ["    WHEN", "EXIT", "DURATION", "TURNS", "COST"])
        print()

    # ---- new ----
    def do_new(self, arg):
        """new — interactive wizard that scaffolds a job (does NOT enable it)."""
        if not sys.stdin.isatty():
            return self.fail("`new` is interactive; run it from a terminal")
        st = cli_state()

        def ask(label, default="", validate=None):
            while True:
                suffix = dim(" [%s]" % default) if default else ""
                try:
                    raw = input("  %s%s: " % (label, suffix)).strip()
                except (EOFError, KeyboardInterrupt):
                    print()
                    raise
                val = raw or default
                if not val:
                    err("required")
                    continue
                if validate:
                    problem = validate(val)
                    if problem:
                        err(problem)
                        continue
                return val

        def ask_optional(label, default=""):
            """Like ask(), but blank is a valid answer (returns "")."""
            suffix = dim(" [%s]" % default) if default else dim(" [blank]")
            try:
                raw = input("  %s%s: " % (label, suffix)).strip()
            except (EOFError, KeyboardInterrupt):
                print()
                raise
            return raw or default

        print(bold("\nnew job\n"))
        try:
            def check_name(v):
                if not NAME_RE.match(v):
                    return ("job names must match ^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]$ "
                            "— the name becomes a launchd label and a path")
                if os.path.exists(os.path.join(AGENTS_DIR, v)):
                    return "%s already exists" % v
                return None

            name = ask("job name", validate=check_name)

            print(dim("    runners: claude (thinking/strategy) | jiva (low-level action execution)"))
            runner = ask("runner", st.get("last_runner", "claude"),
                        lambda v: None if v in RUNNERS
                        else "pick one of: " + ", ".join(RUNNERS))

            if runner == "jiva":
                self._new_jiva_job(name, st, ask, ask_optional)
            else:
                self._new_claude_job(name, st, ask)
        except (EOFError, KeyboardInterrupt):
            return self.fail("cancelled")

    def _new_claude_job(self, name, st, ask):
        repo = ask("repo dir (the brain repo Claude runs inside)",
                   st.get("repo_dir", ""),
                   lambda v: None if os.path.isdir(os.path.expanduser(v))
                   else "not a directory: %s" % v)
        repo = os.path.abspath(os.path.expanduser(repo))
        if not git_info(repo):
            warn("%s is not a git repo — the run header won't have a commit" % repo)

        def check_model(v):
            if v in MODEL_ALIASES:
                return ("%r is an alias; it moves when Anthropic ships a release. "
                        "Pin a full ID, e.g. claude-sonnet-5" % v)
            return None

        model = ask("model (pinned full ID)", st.get("model", DEFAULT_MODEL),
                    check_model)

        print(dim("    modes: " + " | ".join(PERMISSION_MODES)))
        supported = auto_mode_supported(model)

        def check_mode(v):
            if v not in PERMISSION_MODES:
                return "pick one of: " + ", ".join(PERMISSION_MODES)
            # §9.4: an unsupported model + auto fails at startup, not
            # gracefully at runtime. Refuse to scaffold a broken job.
            if v == "auto" and supported is False:
                return ("auto mode needs Opus 4.6+, Sonnet 4.6+ or Fable 5; "
                        "%s does not support it and the job would fail at "
                        "startup. Use dontAsk, or restart with a newer model."
                        % model)
            return None

        mode = ask("permission mode", st.get("permission_mode", "dontAsk"),
                   check_mode)
        if mode == "auto" and supported is None:
            warn("cannot verify that %s supports auto mode — if it does not, "
                 "the job fails at startup" % model)
        if mode == "auto":
            print(dim("    note: under -p, repeated classifier blocks abort the "
                      "session, and each check costs tokens."))
        if mode == "bypassPermissions":
            warn("bypassPermissions disables all safety checks and refuses to "
                 "start under root/sudo. No acceptance dialog is shown under -p.\n"
                 "      Only use this for a genuinely isolated repo.")

        print(dim("    " + SCHEDULE_HELP))
        spec_holder = {}

        def check_spec(v):
            try:
                spec_holder["parsed"] = parse_schedule(v)
            except ValueError as exc:
