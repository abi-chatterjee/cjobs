# ─────────────────────────── doctor plumbing ──────────────────────────

class Doctor:
    def __init__(self):
        self.results = []
        self.failures = 0
        self.warnings = 0

    def _emit(self, tag, name, detail, remedy=None):
        print("%s %s" % (tag, bold(name)))
        if detail:
            print("       %s" % detail)
        if remedy:
            print("    %s %s" % (yellow("fix:"), remedy))

    def ok(self, name, detail=""):
        self.results.append(("PASS", name))
        self._emit(green("PASS"), name, dim(detail))

    def bad(self, name, detail, remedy):
        self.failures += 1
        self.results.append(("FAIL", name))
        self._emit(red("FAIL"), name, detail, remedy)

    def warn_(self, name, detail, remedy):
        self.warnings += 1
        self.results.append(("WARN", name))
        self._emit(yellow("WARN"), name, detail, remedy)

    def skip(self, name, detail=""):
        self.results.append(("SKIP", name))
        self._emit(dim("SKIP"), name, dim(detail))

    def report(self):
        passed = sum(1 for s, _ in self.results if s == "PASS")
        print()
        summary = "%d passed, %d failed, %d warning(s)" % (
            passed, self.failures, self.warnings)
        print(bold(red(summary)) if self.failures else
              (bold(yellow(summary)) if self.warnings else bold(green(summary))))


# ─────────────────────────── scaffolding ──────────────────────────────

def write_run_sh(job, values, template_name="run.sh.tmpl"):
    with open(os.path.join(TEMPLATES, template_name)) as fh:
        tmpl = fh.read()
    extra = values.get("EXTRA_DIRS") or []
    subs = dict(values)
    subs["EXTRA_DIRS"] = " ".join('"%s"' % d for d in extra)
    for key, val in subs.items():
        tmpl = tmpl.replace("@@%s@@" % key, str(val))
    left = re.findall(r"@@([A-Z_]+)@@", tmpl)
    if left:
        raise ValueError("run.sh template has unsubstituted placeholders: %s"
                         % ", ".join(sorted(set(left))))
    with open(job.run_sh, "w") as fh:
        fh.write(tmpl)
    os.chmod(job.run_sh, 0o755)


def write_plist(job, entries):
    with open(os.path.join(TEMPLATES, "launchd.plist.tmpl")) as fh:
        tmpl = fh.read()
    body = (tmpl.replace("@@LABEL@@", job.label)
                .replace("@@RUN_SH@@", job.run_sh)
                .replace("@@LOG_ROOT@@", job.logs_dir)
                .replace("@@CALENDAR@@", render_calendar(entries)))
    os.makedirs(LAUNCH_AGENTS, exist_ok=True)
    os.makedirs(job.logs_dir, exist_ok=True)
    tmp = job.plist + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(body)
    rc, _, error = run(["plutil", "-lint", tmp])
    if rc != 0:
        os.remove(tmp)
        raise ValueError("generated plist is invalid: %s" % error.strip())
    os.replace(tmp, job.plist)
    return job.plist


# ─────────────────────────── background services ──────────────────────
# cjob-web + its ngrok tunnel: fixed singletons (not per-job), so no
# template substitution — generated inline, same tmp/plutil-lint/atomic-
# rename safety as write_plist above. RunAtLoad+KeepAlive (not
# StartCalendarInterval — these run continuously, not on a schedule),
# mirroring the same pattern already used by this machine's own
# ai.karmaloop.jivam launchd agent.

def service_plist_path(label):
    return os.path.join(LAUNCH_AGENTS, label + ".plist")


def write_service_plist(label, program_args, log_path, extra_env=None):
    os.makedirs(LAUNCH_AGENTS, exist_ok=True)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    args_xml = "".join("    <string>%s</string>\n" % a for a in program_args)
    env_xml = ""
    if extra_env:
        entries = "".join(
            "    <key>%s</key><string>%s</string>\n" % (k, v) for k, v in extra_env.items()
        )
        env_xml = "  <key>EnvironmentVariables</key>\n  <dict>\n%s  </dict>\n" % entries
    body = (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
        '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        '<plist version="1.0">\n'
        "<dict>\n"
        "  <key>Label</key><string>%s</string>\n"
        "  <key>ProgramArguments</key>\n"
        "  <array>\n%s  </array>\n"
        "  <key>RunAtLoad</key><true/>\n"
        "  <key>KeepAlive</key><true/>\n"
        "  <key>ThrottleInterval</key><integer>5</integer>\n"
        "  <key>StandardOutPath</key><string>%s</string>\n"
        "  <key>StandardErrorPath</key><string>%s</string>\n"
        "%s"
        "</dict>\n"
        "</plist>\n"
    ) % (label, args_xml, log_path, log_path, env_xml)

    plist_path = service_plist_path(label)
    tmp = plist_path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(body)
    rc, _, error = run(["plutil", "-lint", tmp])
    if rc != 0:
        os.remove(tmp)
        raise ValueError("generated plist is invalid: %s" % error.strip())
    os.replace(tmp, plist_path)
    return plist_path


def service_bootstrap(label, plist_path):
    """(Re)load a background service, reloading if already loaded so the
    current plist takes effect — same reload semantics as do_enable."""
    if agent_loaded(label):
        launchctl("bootout", "%s/%s" % (DOMAIN, label))
    rc, out, error = launchctl("bootstrap", DOMAIN, plist_path)
    if rc != 0:
        rc, out, error = launchctl("load", "-w", plist_path)
        if rc != 0:
            return False, ("launchctl bootstrap/load failed (rc=%d): %s"
                           % (rc, (error or out).strip() or "no output"))
    if not agent_loaded(label):
        return False, "launchctl reported success but %s is not loaded" % label
    return True, None


def service_bootout(label):
    if not agent_loaded(label):
        return True, None
    rc, out, error = launchctl("bootout", "%s/%s" % (DOMAIN, label))
    if rc != 0:
        rc, out, error = launchctl("unload", "-w", service_plist_path(label))
        if rc != 0:
            return False, ("launchctl bootout/unload failed (rc=%d): %s"
                           % (rc, (error or out).strip() or "no output"))
    return True, None


def http_get_json(url, timeout=3):
    """Best-effort local HTTP GET returning parsed JSON, or None on any
    failure (connection refused, timeout, non-JSON body, ...)."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8", "replace"))
    except (urllib.error.URLError, OSError, ValueError, TimeoutError):
        return None


# ─────────────────────────── entrypoint ───────────────────────────────

HISTFILE = os.path.join(JOBS_ROOT, ".state", "cjob.history")


def main(argv):
    if not os.path.isdir(JOBS_ROOT):
        err("%s does not exist" % JOBS_ROOT)
        return 2
    os.makedirs(os.path.dirname(HISTFILE), exist_ok=True)
    shell = Cjob()

    if argv:
        line = " ".join(shlex.quote(a) for a in argv)
        try:
            shell.onecmd(line)
        except KeyboardInterrupt:
            print()
            return 130
        return shell.rc

    if readline is not None:
        try:
            readline.read_history_file(HISTFILE)
        except OSError:
            pass
        readline.set_history_length(2000)
    try:
        while True:
            try:
                shell.cmdloop()
                break
            except KeyboardInterrupt:
                print("\n" + dim("^C  (type `quit` to exit)"))
                shell.intro = None
    finally:
        if readline is not None:
            try:
                readline.write_history_file(HISTFILE)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
