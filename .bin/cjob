    # ---- edit ----
    def do_edit(self, arg):
        """edit <job> [prompt|script|config] — open a job file in $EDITOR."""
        parts = shlex.split(arg)
        job = get_job(parts[0] if parts else "")
        if not job:
            return self.fail()
        what = (parts[1] if len(parts) > 1 else "prompt").lower()
        target = {"prompt": job.prompt, "script": job.run_sh, "run": job.run_sh,
                  "config": job.job_json, "job": job.job_json}.get(what)
        if not target:
            return self.fail("edit what? prompt | script | config")
        if what in ("config", "job"):
            warn("job.json is metadata; run.sh is the source of truth for how the "
                 "job runs. Editing config here will be overwritten on next sync "
                 "for any key run.sh owns.")
        rc = open_editor(target)
        if what in ("script", "run"):
            job.meta()  # resync job.json from the edited variable block
            print(dim("job.json resynced from run.sh"))
        if what in ("config", "job"):
            # `enabled` in job.json is metadata. launchd is the only authority on
            # whether the job actually fires, and an editor cannot talk to it.
            meta = job.meta()
            loaded = agent_loaded(job.label)
            if meta.get("enabled") and not loaded:
                warn("job.json now says enabled, but launchd has no agent for %s "
                     "— it will NOT fire.\n      Editing job.json cannot schedule "
                     "anything. Run: %s" % (job.name, bold("cjob enable " + job.name)))
                self.rc = 1
            elif loaded and not meta.get("enabled"):
                warn("job.json now says disabled, but the launchd agent is still "
                     "loaded and WILL fire.\n      Run: %s"
                     % bold("cjob disable " + job.name))
                self.rc = 1
        if rc:
            self.rc = rc

    # ---- run ----
    def do_run(self, arg):
        """run <job> — run run.sh now in the foreground, with a stripped env."""
        job = get_job(shlex.split(arg)[0] if arg.strip() else "")
        if not job:
            return self.fail()
        if not os.access(job.run_sh, os.X_OK):
            warn("%s is not executable — fixing" % job.run_sh)
            try:
                os.chmod(job.run_sh, 0o755)
            except OSError as exc:
                return self.fail("chmod failed: %s" % exc)
        # §9.7: `env -i` so a passing run actually proves something.
        argv = ["/usr/bin/env", "-i", "/bin/bash", job.run_sh]
        print(dim("$ " + " ".join(shlex.quote(a) for a in argv)))
        try:
            rc = subprocess.call(argv)
        except KeyboardInterrupt:
            print()
            warn("interrupted — run.sh's EXIT trap releases the lock")
            self.rc = 130
            return
        except OSError as exc:
            return self.fail("cannot run: %s" % exc)
        print((green("exit 0") if rc == 0 else red("exit %d" % rc)))
        if rc:
            self.rc = rc

    # ---- logs ----
    def do_logs(self, arg):
        """logs <job> [--date YYYY-MM-DD] — list runs for a date."""
        parts = shlex.split(arg)
        date = None
        if "--date" in parts:
            i = parts.index("--date")
            if i + 1 >= len(parts):
                return self.fail("--date needs YYYY-MM-DD")
            date = parts[i + 1]
            parts = parts[:i] + parts[i + 2:]
        job = get_job(parts[0] if parts else "")
        if not job:
            return self.fail()
        dates = job.log_dates()
        if not dates:
            print(dim("no logs yet for %s" % job.name))
            return
        if date is None:
            today = datetime.date.today().isoformat()
            date = today if today in dates else dates[-1]
            if date != today:
                print(dim("no runs today; showing most recent date with runs"))
        elif date not in dates:
            return self.fail("no logs for %s on %s (have: %s)"
                             % (job.name, date, ", ".join(dates[-8:])))
        runs = job.runs_on(date)
        print(bold("%s — %s  (%d run%s)"
                   % (job.name, date, len(runs), "" if len(runs) == 1 else "s")))
        table([[r["time"], fmt_exit(r), fmt_dur(r["duration_seconds"]),
                dim("—") if r["num_turns"] is None else str(r["num_turns"]),
                fmt_cost(r["total_cost_usd"]),
                dim(os.path.basename(r["log"]))] for r in runs],
              ["TIME", "EXIT", "DURATION", "TURNS", "COST", "FILE"])
        print(dim("\n`log %s %s <time>` to print one" % (job.name, date)))

    # ---- log ----
    def do_log(self, arg):
        """log <job> [<date> <time>] — print one log; bare form = latest run."""
        parts = shlex.split(arg)
        job = get_job(parts[0] if parts else "")
        if not job:
            return self.fail()
        if len(parts) >= 3:
            path = os.path.join(job.logs_dir, parts[1],
                                parts[2].replace(":", "-") + ".log")
        else:
            runs = job.recent_runs(1)
            if not runs:
                return self.fail("no runs yet for %s" % job.name)
            path = runs[0]["log"]
        if not os.path.isfile(path):
            return self.fail("no such log: %s" % path)
        print(dim("── %s ──" % path))
        try:
            with open(path, errors="replace") as fh:
                sys.stdout.write(fh.read())
        except OSError as exc:
            return self.fail("cannot read %s: %s" % (path, exc))

    # ---- tail ----
    def do_tail(self, arg):
        """tail <job> — follow the newest log file live (Ctrl-C to stop)."""
        job = get_job(shlex.split(arg)[0] if arg.strip() else "")
        if not job:
            return self.fail()
        deadline = time.time() + 20
        path = None
        while True:
            runs = job.recent_runs(1)
            if runs:
                path = runs[0]["log"]
                break
            if time.time() > deadline:
                return self.fail("no logs yet for %s" % job.name)
            if _TTY:
                print(dim("waiting for a log to appear..."), end="\r", flush=True)
            time.sleep(1)
        print(dim("── tail -f %s ──  (Ctrl-C to stop)" % path))
        try:
            subprocess.call(["tail", "-n", "200", "-f", path])
        except KeyboardInterrupt:
            print()
        except OSError as exc:
            return self.fail("tail failed: %s" % exc)

    # ---- enable / disable ----
    def do_enable(self, arg):
        """enable <job> — bootstrap the launchd agent."""
        job = get_job(shlex.split(arg)[0] if arg.strip() else "")
        if not job:
            return self.fail()
        meta = job.meta()
        entries = (meta.get("schedule") or {}).get("entries")
        if not entries:
            return self.fail("%s has no schedule — `schedule %s <spec>` first.\n  %s"
                             % (job.name, job.name, SCHEDULE_HELP))
        if not os.access(job.run_sh, os.X_OK):
            try:
                os.chmod(job.run_sh, 0o755)
                print(dim("chmod +x %s" % job.run_sh))
            except OSError as exc:
                return self.fail("run.sh is not executable and chmod failed: %s" % exc)
        write_plist(job, entries)
        if agent_loaded(job.label):
            print(dim("already loaded; reloading to pick up the current plist"))
            launchctl("bootout", "%s/%s" % (DOMAIN, job.label))
        rc, out, error = launchctl("bootstrap", DOMAIN, job.plist)
        if rc != 0:
            warn("launchctl bootstrap failed (rc=%d): %s"
                 % (rc, (error or out).strip() or "no output"))
            print(dim("falling back to `launchctl load -w`"))
            rc, out, error = launchctl("load", "-w", job.plist)
            if rc != 0:
                return self.fail("launchctl load -w also failed (rc=%d): %s"
                                 % (rc, (error or out).strip() or "no output"))
        if not agent_loaded(job.label):
            return self.fail("launchctl reported success but %s is not loaded"
                             % job.label)
        meta["enabled"] = True
        job.write_meta(meta)
        print(green("enabled %s" % job.name) + " — %s" % describe_schedule(meta))
        print(dim("  launchd runs a missed StartCalendarInterval on wake, so a "
                  "closed lid delays the run rather than skipping it"))

    def do_disable(self, arg):
        """disable <job> — bootout the launchd agent."""
        job = get_job(shlex.split(arg)[0] if arg.strip() else "")
        if not job:
            return self.fail()
        meta = job.meta()
        if not agent_loaded(job.label):
            meta["enabled"] = False
            job.write_meta(meta)
            print(dim("%s was not loaded; marked disabled" % job.name))
            return
        rc, out, error = launchctl("bootout", "%s/%s" % (DOMAIN, job.label))
        if rc != 0:
            warn("launchctl bootout failed (rc=%d): %s"
                 % (rc, (error or out).strip() or "no output"))
            print(dim("falling back to `launchctl unload -w`"))
            rc, out, error = launchctl("unload", "-w", job.plist)
            if rc != 0:
                return self.fail("launchctl unload -w also failed (rc=%d): %s"
                                 % (rc, (error or out).strip() or "no output"))
        meta["enabled"] = False
        job.write_meta(meta)
        print(green("disabled %s" % job.name))

    # ---- schedule ----
    def do_schedule(self, arg):
        """schedule <job> <spec> — set fire times. hourly | daily 03:00 | mon,thu 07:00"""
        parts = shlex.split(arg)
        job = get_job(parts[0] if parts else "")
        if not job:
            return self.fail()
        if len(parts) < 2:
            meta = job.meta()
            print("%s: %s" % (job.name, describe_schedule(meta)))
            print(dim(SCHEDULE_HELP))
            return
        try:
            canon, entries = parse_schedule(" ".join(parts[1:]))
        except ValueError as exc:
            return self.fail(str(exc))
        meta = job.meta()
        meta["schedule"] = {"spec": canon, "entries": entries}
        job.write_meta(meta)
        write_plist(job, entries)
        print(green("schedule set") + ": %s -> %s" % (job.name, canon))
        for entry in entries:
            bits = []
            if "Weekday" in entry:
                bits.append(DAY_NAMES[entry["Weekday"]])
            if "Hour" in entry:
                bits.append("%02d:%02d" % (entry["Hour"], entry["Minute"]))
            else:
                bits.append("every hour at :%02d" % entry["Minute"])
            print(dim("  " + " ".join(bits)))
        if meta.get("enabled") or agent_loaded(job.label):
            print(dim("reloading the agent to apply..."))
            launchctl("bootout", "%s/%s" % (DOMAIN, job.label))
            rc, out, error = launchctl("bootstrap", DOMAIN, job.plist)
            if rc != 0:
                rc, out, error = launchctl("load", "-w", job.plist)
            if rc != 0 or not agent_loaded(job.label):
                meta["enabled"] = False
                job.write_meta(meta)
                return self.fail("reload failed (rc=%d): %s — job is now DISABLED"
                                 % (rc, (error or out).strip() or "no output"))
            print(green("reloaded"))

    # ---- usage ----
    def do_usage(self, arg):
        """usage [<job>] [--days N] — aggregate cost and turns across runs."""
        parts = shlex.split(arg)
        days = 7
        if "--days" in parts:
            i = parts.index("--days")
            if i + 1 >= len(parts) or not parts[i + 1].isdigit():
                return self.fail("--days needs a positive integer")
            days = int(parts[i + 1])
            parts = parts[:i] + parts[i + 2:]
        jobs = list_jobs()
        if parts:
            job = get_job(parts[0])
            if not job:
                return self.fail()
            jobs = [job]
        if not jobs:
            print(dim("no jobs"))
            return

        cutoff = datetime.date.today() - datetime.timedelta(days=days - 1)
        rows, tot_cost, tot_turns, tot_runs, tot_err, tot_secs = [], 0.0, 0, 0, 0, 0
        auto_jobs = []
        for job in jobs:
            cost = turns = runs = errs = secs = 0
            cost = 0.0
            for date in job.log_dates():
                try:
                    day = datetime.date.fromisoformat(date)
                except ValueError:
                    continue
                if day < cutoff:
                    continue
                for rec in job.runs_on(date):
                    if rec.get("skipped"):
                        continue
                    runs += 1
                    if rec.get("is_error"):
                        errs += 1
                    if rec.get("total_cost_usd"):
                        cost += rec["total_cost_usd"]
                    if rec.get("num_turns"):
                        turns += rec["num_turns"]
                    if rec.get("duration_seconds"):
                        secs += rec["duration_seconds"]
            meta = job.meta()
            if meta.get("permission_mode") == "auto":
                auto_jobs.append(job.name)
            rows.append([job.name, str(runs),
                         red(str(errs)) if errs else green("0"),
                         str(turns), fmt_dur(secs) if secs else dim("—"),
                         "$%.4f" % cost,
                         "$%.4f" % (cost / runs) if runs else dim("—")])
            tot_cost += cost
            tot_turns += turns
            tot_runs += runs
            tot_err += errs
            tot_secs += secs

        print(bold("usage — last %d day%s (since %s)"
                   % (days, "" if days == 1 else "s", cutoff.isoformat())))
        table(rows, ["JOB", "RUNS", "ERRORS", "TURNS", "WALL", "COST", "COST/RUN"])
        print(bold("\n  total: %d runs, %d errors, %d turns, %s wall, $%.4f"
                   % (tot_runs, tot_err, tot_turns, fmt_dur(tot_secs), tot_cost)))
        print(dim("\n  Cost is an est. API-equivalent figure (Claude jobs: Max plan quota,"))
        print(dim("  NOT a bill; Jiva jobs: only computed if you set a $/1M-token price)."))
        print(dim("  On a Max subscription Claude runs consume plan quota (a rolling 5-hour window"))
        print(dim("  plus a weekly cap), and they compete with your interactive usage for"))
        print(dim("  the same quota — one reason to schedule for 3am."))
        if auto_jobs:
            print(yellow("\n  auto-mode jobs: %s" % ", ".join(auto_jobs)))
            print(dim("  Auto mode routes shell commands and network calls through a"))
            print(dim("  classifier; each check sends transcript context, so cost per turn"))
            print(dim("  is meaningfully higher than dontAsk. Reads and working-directory"))
            print(dim("  edits skip it. If runs die early, narrow the prompt or add explicit"))
            print(dim("  allow rules — do not just raise --max-turns."))
        if tot_err:
            print(yellow("\n  %d run%s errored — `logs <job>` then `log <job> <date> <time>`"
                         % (tot_err, "" if tot_err == 1 else "s")))

    # ---- rm ----
    def do_rm(self, arg):
        """rm <job> — disable and delete a job after typed confirmation."""
        job = get_job(shlex.split(arg)[0] if arg.strip() else "")
        if not job:
            return self.fail()
        if not sys.stdin.isatty():
            return self.fail("`rm` requires an interactive confirmation")
        print("about to delete %s" % bold(job.dir))
        runs = len([r for d in job.log_dates() for r in job.runs_on(d)])
        print(dim("  %d logged run(s), plist %s"
                  % (runs, "present" if os.path.exists(job.plist) else "absent")))
        try:
            typed = input("type the job name to confirm: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return self.fail("cancelled")
        if typed != job.name:
            return self.fail("name did not match — nothing deleted")
        keep_logs = False
        if runs:
            try:
                keep_logs = input("keep logs? [y/N]: ").strip().lower().startswith("y")
            except (EOFError, KeyboardInterrupt):
                print()
                return self.fail("cancelled")

        if agent_loaded(job.label):
            rc, out, error = launchctl("bootout", "%s/%s" % (DOMAIN, job.label))
            if rc != 0:
                launchctl("unload", "-w", job.plist)
            if agent_loaded(job.label):
                return self.fail("could not unload %s — refusing to delete a job "
                                 "launchd still knows about: %s"
                                 % (job.label, (error or out).strip()))
            print(dim("unloaded %s" % job.label))
        if os.path.exists(job.plist):
            try:
                os.remove(job.plist)
                print(dim("removed %s" % job.plist))
            except OSError as exc:
                warn("could not remove plist: %s" % exc)

        kept = None
        if keep_logs:
            kept = os.path.join(AGENTS_DIR, ".archived-logs", job.name)
            os.makedirs(os.path.dirname(kept), exist_ok=True)
            if os.path.exists(kept):
                kept += "-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
            try:
                shutil.move(job.logs_dir, kept)
            except (OSError, shutil.Error) as exc:
                warn("could not preserve logs: %s" % exc)
                kept = None
        try:
            shutil.rmtree(job.dir)
        except OSError as exc:
            return self.fail("could not delete %s: %s" % (job.dir, exc))
        print(green("deleted %s" % job.name))
        if kept:
            print("  logs kept at %s" % kept)

    # ---- doctor ----
    def do_doctor(self, arg):
        """doctor [--quick] — run every health check. --quick skips the live token test."""
        parts = shlex.split(arg)
        quick = "--quick" in parts or "--no-token-test" in parts
        d = Doctor()
        jobs = list_jobs()
        cfgs = [(j, j.config()) for j in jobs]

        # Every distinct binary/token across all jobs, not just the first one's.
        def distinct(key, fallback):
            vals = sorted({(cfg.get(key) or fallback) for _, cfg in cfgs})
            return vals or [fallback]

        bins = distinct("CLAUDE_BIN", DEFAULT_CLAUDE_BIN)
        tokens = distinct("TOKEN_FILE", DEFAULT_TOKEN_FILE)

        def users_of(key, value, fallback):
            return [j.name for j, cfg in cfgs if (cfg.get(key) or fallback) == value]

        # 1 — claude binary
        good_bins, notes, problems = [], [], []
        for path in bins:
            who = ", ".join(users_of("CLAUDE_BIN", path, DEFAULT_CLAUDE_BIN)) or "default"
            if not (os.path.isfile(path) and os.access(path, os.X_OK)):
                problems.append("%s: not executable (used by %s)" % (path, who))
                continue
            rc, out, _ = run([path, "--version"], timeout=30)
            if rc != 0:
                problems.append("%s: `--version` failed rc=%d (used by %s)"
                                % (path, rc, who))
                continue
            good_bins.append(path)
            notes.append("%s — %s" % (path, out.strip()))
        if problems:
            d.bad("claude binary", "; ".join(problems),
                  "install Claude Code (claude install stable), or fix CLAUDE_BIN in\n"
                  "    the job's run.sh — run.sh is the source of truth")
        else:
            d.ok("claude binary", "; ".join(notes))
        claude_bin = good_bins[0] if good_bins else bins[0]

        # 2 — token files
        good_tokens, notes, problems = [], [], []
        for path in tokens:
            who = ", ".join(users_of("TOKEN_FILE", path, DEFAULT_TOKEN_FILE)) or "default"
            if not os.path.isfile(path):
                problems.append("%s: missing (used by %s)" % (path, who))
                continue
            mode = os.stat(path).st_mode & 0o777
            try:
                with open(path) as fh:
                    body = fh.read().strip()
            except OSError as exc:
                problems.append("%s: cannot read (%s)" % (path, exc))
                continue
            if not body:
                problems.append("%s: empty (used by %s)" % (path, who))
            elif mode != 0o600:
                problems.append("%s: mode %o, want 600" % (path, mode))
            else:
                good_tokens.append(path)
                notes.append("%s — %d bytes, mode 600" % (path, len(body)))
        if problems:
            d.bad("token file", "; ".join(problems),
                  "\n    ".join("claude setup-token > %s && chmod 600 %s" % (p, p)
                                for p in tokens))
        else:
            d.ok("token file", "; ".join(notes))
        token_file = good_tokens[0] if good_tokens else tokens[0]

        # 3 — ANTHROPIC_API_KEY must not be in the login environment (§9.2)
        problems = []
        rc, out, _ = launchctl("getenv", "ANTHROPIC_API_KEY")
        if rc == 0 and out.strip():
            problems.append("launchctl getenv ANTHROPIC_API_KEY is set "
                            "(launchctl unsetenv ANTHROPIC_API_KEY)")
        for rcfile in (".zshrc", ".zprofile", ".zshenv", ".bash_profile", ".profile"):
            path = os.path.join(HOME, rcfile)
            if not os.path.isfile(path):
                continue
            try:
                with open(path, errors="replace") as fh:
                    for num, line in enumerate(fh, 1):
                        bare = line.strip()
                        if bare.startswith("#") or "ANTHROPIC_API_KEY" not in bare:
                            continue
                        if re.search(r"\b(export|set|setenv)\b.*ANTHROPIC_API_KEY|"
                                     r"^ANTHROPIC_API_KEY=", bare):
                            problems.append("~/%s:%d sets it" % (rcfile, num))
            except OSError:
                continue
        if os.environ.get("ANTHROPIC_API_KEY"):
            problems.append("it is set in this shell's environment")
        if problems:
            d.bad("ANTHROPIC_API_KEY absent", "; ".join(problems),
                  "An API key takes precedence over the subscription credential, so\n"
                  "    the job would quietly bill Console credits instead of the Max plan.\n"
                  "    Remove it from the login environment. (run.sh unsets it too.)")
        else:
            d.ok("ANTHROPIC_API_KEY absent",
                 "not in launchctl env, shell rc files, or this shell")

        # 4 — token is live
        if quick:
            d.skip("token is live", "skipped (--quick)")
        elif not (good_tokens and good_bins):
            d.skip("token is live", "skipped — no usable token/binary")
        else:
            env = stripped_env(token_file)
            if "CLAUDE_CODE_OAUTH_TOKEN" not in env:
                d.bad("token is live", "no token to test", "see the token file check")
            else:
                rc, out, error = run(
                    [claude_bin, "-p", "reply with the single word: ok",
                     "--model", "claude-haiku-4-5-20251001",
                     "--permission-mode", "dontAsk", "--max-turns", "1",
                     "--output-format", "json"],
                    env=env, cwd=HOME, timeout=180)
                data = None
                try:
                    data = json.loads(out)
                except ValueError:
                    pass
                if isinstance(data, dict) and not data.get("is_error"):
                    d.ok("token is live", "haiku replied: %r"
                         % str(data.get("result", ""))[:40])
                elif isinstance(data, dict):
                    detail = redact(data.get("result", ""))[:240]
                    remedy = ("the token is expired or revoked — regenerate:\n"
                              "    claude setup-token > %s && chmod 600 %s"
                              % (token_file, token_file))
                    if "invalid value" in detail or "Authorization" in detail:
                        remedy = ("the token was rejected as malformed, not expired —\n"
                                  "    %s most likely contains a stray line break.\n"
                                  "    Rewrite it on one line:\n"
                                  "    claude setup-token | tr -d '[:space:]' > %s "
                                  "&& chmod 600 %s" % (token_file, token_file, token_file))
                    d.bad("token is live", detail, remedy)
                else:
                    d.bad("token is live", "no JSON result (rc=%d) %s"
                          % (rc, redact((error or out).strip())[:240]),
                          "run the same command by hand to see the failure")

        # 5 — each job's REPO_DIR
        if not cfgs:
            d.skip("job repos", "no jobs defined")
        else:
            bad = []
            for job, cfg in cfgs:
                repo = cfg.get("REPO_DIR", "")
                if not repo:
                    bad.append("%s: REPO_DIR is empty" % job.name)
                elif not os.path.isdir(repo):
                    bad.append("%s: %s does not exist" % (job.name, repo))
                elif not git_info(repo):
                    bad.append("%s: %s is not a git repo" % (job.name, repo))
            if bad:
                d.bad("job repos", "; ".join(bad),
                      "fix REPO_DIR in the job's run.sh (run.sh is the source of truth),\n"
                      "    then `cjob show <job>` to confirm")
            else:
                d.ok("job repos", "%d repo(s) present and git-tracked" % len(cfgs))

        # 6 — run.sh executable
        if not jobs:
            d.skip("run.sh executable", "no jobs defined")
        else:
            bad = [j.name for j in jobs if not os.access(j.run_sh, os.X_OK)]
            if bad:
                d.bad("run.sh executable", "not executable: %s" % ", ".join(bad),
                      "chmod +x " + " ".join(
                          os.path.join(AGENTS_DIR, n, "run.sh") for n in bad))
            else:
                d.ok("run.sh executable", "%d script(s) executable" % len(jobs))

        # 7 — launchd agents match jobs
        loaded_labels = set()
        rc2, listing, _ = launchctl("list")
        if rc2 == 0:
            for line in listing.splitlines()[1:]:
                bits = line.split()
                if bits and bits[-1].startswith(LABEL_PREFIX):
                    loaded_labels.add(bits[-1])
        plist_labels = set()
        try:
            for name in os.listdir(LAUNCH_AGENTS):
                if name.startswith(LABEL_PREFIX) and name.endswith(".plist"):
                    plist_labels.add(name[:-len(".plist")])
        except OSError:
            pass
        troubles = []
        for job in jobs:
            meta = job.meta()
            if meta.get("enabled") and job.label not in loaded_labels:
                troubles.append("%s is enabled in job.json but not loaded "
                                "(cjob enable %s)" % (job.name, job.name))
        known = {j.label for j in jobs}
        for label in sorted(loaded_labels | plist_labels):
            if label not in known:
                troubles.append("orphan: %s has no job directory "
                                "(launchctl bootout %s/%s; rm %s/%s.plist)"
                                % (label, DOMAIN, label, LAUNCH_AGENTS, label))
        if troubles:
            d.bad("launchd agents", "; ".join(troubles), "see parentheses above")
        else:
            d.ok("launchd agents", "%d loaded, %d plist(s), no orphans"
                 % (len(loaded_labels), len(plist_labels)))

        # 8 — Full Disk Access for /bin/bash
        probe = os.path.join(HOME, "Library", "Application Support",
                             "com.apple.TCC", "TCC.db")
        rc, out, error = run(["/bin/bash", "-c",
                              'head -c 16 "$1" >/dev/null 2>&1 && echo yes || echo no',
                              "_", probe])
        if out.strip() == "yes":
            d.ok("Full Disk Access", "/bin/bash can read TCC-protected paths")
        else:
            d.bad("Full Disk Access", "/bin/bash cannot read %s" % probe,
                  "TCC will block a scheduled run from reading ~/Documents, ~/Desktop,\n"
                  "    ~/Downloads and iCloud Drive. Grant it to /bin/bash (the plist\n"
                  "    invokes /bin/bash, so the grant must be on the shell, not the repo):\n"
                  "    " + FDA_HELP.replace("\n", "\n    ") + "\n"
                  "    Caveat: this probe reflects the terminal running cjob. The\n"
                  "    definitive test is one scheduled run that touches such a path.")

        # 9 — pinned models (Claude jobs only — Jiva has no model-alias concept)
        claude_cfgs = [(j, cfg) for j, cfg in cfgs if cfg.get("RUNNER", "claude") != "jiva"]
        aliased = [(j.name, cfg.get("MODEL", ""))
                   for j, cfg in claude_cfgs if cfg.get("MODEL", "") in MODEL_ALIASES]
        if not claude_cfgs:
            d.skip("models pinned", "no claude jobs defined")
        elif aliased:
            d.warn_("models pinned",
                    "; ".join("%s uses the alias %r" % (n, m) for n, m in aliased),
                    "Aliases resolve to a floating default that moves when Anthropic\n"
                    "    ships a release, changing this job's behaviour and cost without\n"
                    "    you touching anything. Pin a full ID, e.g. claude-sonnet-5.")
        else:
            d.ok("models pinned", "all %d claude job(s) pin a full model ID" % len(claude_cfgs))

        # 10 — auto mode preconditions (§9.4)
        auto_bad, auto_unknown, auto_ok_jobs = [], [], []
        for job, cfg in cfgs:
            if cfg.get("PERMISSION_MODE") != "auto":
                continue
            model = cfg.get("MODEL", "")
            supported = auto_mode_supported(model)
            if supported is True:
                auto_ok_jobs.append(job.name)
            elif supported is False:
                auto_bad.append("%s: %s does not support auto mode" % (job.name, model))
            else:
                auto_unknown.append("%s: cannot verify %s supports auto mode"
                                    % (job.name, model))
        if not any(cfg.get("PERMISSION_MODE") == "auto" for _, cfg in cfgs):
            d.ok("auto-mode model gating", "no job uses auto mode")
        elif auto_bad:
            d.bad("auto-mode model gating", "; ".join(auto_bad),
                  "Auto mode needs Opus 4.6+, Sonnet 4.6+, or Fable 5. With an\n"
                  "    unsupported model the job fails at startup, not gracefully at\n"
                  "    runtime. Switch PERMISSION_MODE to dontAsk or pin a newer model.")
        elif auto_unknown:
            d.warn_("auto-mode model gating", "; ".join(auto_unknown),
                    "verify the model supports auto mode (Opus 4.6+/Sonnet 4.6+/Fable 5)")
        else:
            d.ok("auto-mode model gating", "auto mode ok for: %s"
                 % ", ".join(auto_ok_jobs))
            print(dim("       under -p there is nobody to prompt, so repeated classifier\n"
                      "       blocks abort the session; classifier calls also cost tokens"))

        # 11 — is --max-turns actually honoured by this claude build?
        rc, out, _ = run([claude_bin, "--help"], timeout=30)
        if rc != 0:
            d.skip("--max-turns honoured", "could not read `claude --help`")
        elif "--max-turns" in out:
            d.ok("--max-turns honoured", "advertised by claude --help")
        else:
            d.warn_("--max-turns honoured",
                    "claude %s does not advertise --max-turns in --help"
                    % (run([claude_bin, "--version"])[1].strip() or "?"),
                    "The flag is accepted without error but is not documented in this\n"
                    "    build, so do not rely on MAX_TURNS as a ceiling. MAX_BUDGET_USD\n"
                    "    (--max-budget-usd) and TIMEOUT_SECONDS are the enforced limits.")

        # 12/13/14 — jiva-runner jobs
        jiva_cfgs = [(j, cfg) for j, cfg in cfgs if cfg.get("RUNNER") == "jiva"]
        if not jiva_cfgs:
            d.skip("jiva binary", "no jiva jobs defined")
            d.skip("jiva config file", "no jiva jobs defined")
            d.skip("jiva code-mode safety gate", "no jiva jobs defined")
        else:
            # 12 — jiva binary
            jiva_bins = sorted({(cfg.get("JIVA_BIN") or DEFAULT_JIVA_BIN) for _, cfg in jiva_cfgs})
            problems = []
            for path in jiva_bins:
                who = ", ".join(j.name for j, cfg in jiva_cfgs
                                if (cfg.get("JIVA_BIN") or DEFAULT_JIVA_BIN) == path)
                if not (os.path.isfile(path) and os.access(path, os.X_OK)):
                    problems.append("%s: not executable (used by %s)" % (path, who))
                    continue
                rc, out, _ = run([path, "--version"], timeout=30)
                if rc != 0:
                    problems.append("%s: `--version` failed rc=%d (used by %s)"
                                    % (path, rc, who))
            if problems:
                d.bad("jiva binary", "; ".join(problems),
                      "npm install -g jiva-core, or fix JIVA_BIN in the job's run.sh")
            else:
                d.ok("jiva binary", "%d bin(s) OK" % len(jiva_bins))

            # 13 — jiva config file
            jiva_configs = sorted({(cfg.get("JIVA_CONFIG_FILE") or DEFAULT_JIVA_CONFIG_FILE)
                                   for _, cfg in jiva_cfgs})
            problems, warnings_ = [], []
            for path in jiva_configs:
                who = ", ".join(j.name for j, cfg in jiva_cfgs
                                if (cfg.get("JIVA_CONFIG_FILE") or DEFAULT_JIVA_CONFIG_FILE) == path)
                if not os.path.isfile(path):
                    problems.append("%s: missing (used by %s)" % (path, who))
                    continue
                try:
                    with open(path) as fh:
                        data = json.load(fh)
                except (OSError, ValueError) as exc:
                    problems.append("%s: invalid JSON (%s)" % (path, exc))
                    continue
                models = (data.get("models") or {}) if isinstance(data, dict) else {}
                has_key = any((m or {}).get("apiKey") for m in models.values())
                if not has_key:
                    problems.append("%s: no model has a non-empty apiKey" % path)
                    continue
                mode = os.stat(path).st_mode & 0o777
                if mode != 0o600:
                    warnings_.append("%s: mode %o, recommend 600 (cjob doesn't own this "
                                     "file — Jiva/jivam does)" % (path, mode))
            if problems:
                d.bad("jiva config file", "; ".join(problems),
                      "run `jiva setup`, or fix JIVA_CONFIG_FILE in the job's run.sh")
            elif warnings_:
                d.warn_("jiva config file", "; ".join(warnings_), "chmod 600 the file(s) above")
            else:
                d.ok("jiva config file", "%d config(s) present with a usable apiKey"
                     % len(jiva_configs))

            # 14 — code-mode safety gate (informational, always WARN when any exist)
            enabled_jiva = [j.name for j, _ in jiva_cfgs if j.meta().get("enabled")]
            names = ", ".join(j.name for j, _ in jiva_cfgs)
            d.warn_("jiva code-mode safety gate",
                    "jiva job(s): %s%s" % (names,
                        " (enabled: %s)" % ", ".join(enabled_jiva) if enabled_jiva else ""),
                    "Jiva's --code mode has no workspace-boundary check on its write_file/\n"
                    "    edit_file/bash tools — they can reach anywhere this user can, not just\n"
                    "    each job's REPO_DIR. This is a Jiva limitation, not a cjob bug; only\n"
                    "    keep jiva jobs enabled where that risk is acceptable.")

        d.report()
        if d.failures:
            self.rc = 1

    # ---- background services: web + tunnel ----
    def do_web(self, arg):
        """web start|stop|status|restart — the cjob-web control panel service."""
        action = (shlex.split(arg)[0] if arg.strip() else "status").lower()
        if action not in ("start", "stop", "status", "restart"):
            return self.fail("usage: web start|stop|status|restart")

        if action in ("stop", "restart"):
            ok, error = service_bootout(WEB_LABEL)
            if not ok:
                return self.fail(error)
            plist_path = service_plist_path(WEB_LABEL)
            if os.path.exists(plist_path):
                os.remove(plist_path)
            if action == "stop":
                print(green("stopped %s" % WEB_LABEL))

        if action in ("start", "restart"):
            if not os.path.isfile(WEB_SERVER_JS):
                return self.fail("not found: %s (is .web/ set up?)" % WEB_SERVER_JS)
            plist_path = write_service_plist(
                WEB_LABEL, [NODE_BIN, WEB_SERVER_JS],
                os.path.join(WEB_LOGS_DIR, "cjobweb.log"), extra_env={"HOME": HOME})
            ok, error = service_bootstrap(WEB_LABEL, plist_path)
            if not ok:
                return self.fail(error)
            print(green("started %s" % WEB_LABEL) + dim("  (port %d)" % WEB_PORT))

        if action == "status":
            loaded = agent_loaded(WEB_LABEL)
            print("%s  %s" % (WEB_LABEL, green("loaded") if loaded else dim("not loaded")))
            if loaded:
                rc, out, _ = launchctl("print", "%s/%s" % (DOMAIN, WEB_LABEL))
                if rc == 0:
                    for key in ("state =", "pid ="):
                        for line in out.splitlines():
                            if key in line:
                                print("  %s" % dim(line.strip()))
                                break
            health = http_get_json("http://localhost:%d/api/auth/status" % WEB_PORT)
            if health is not None:
                print("  %s http://localhost:%d  %s" % (
                    green("responding"), WEB_PORT,
                    dim("(needsSetup)" if health.get("needsSetup") else "")))
            else:
                print("  %s http://localhost:%d" % (red("not responding"), WEB_PORT))
                if not loaded:
                    self.rc = 1

    def do_tunnel(self, arg):
        """tunnel start|stop|status|restart — the ngrok tunnel onto cjob-web."""
        action = (shlex.split(arg)[0] if arg.strip() else "status").lower()
        if action not in ("start", "stop", "status", "restart"):
            return self.fail("usage: tunnel start|stop|status|restart")

        if action in ("stop", "restart"):
            ok, error = service_bootout(TUNNEL_LABEL)
            if not ok:
                return self.fail(error)
            plist_path = service_plist_path(TUNNEL_LABEL)
            if os.path.exists(plist_path):
                os.remove(plist_path)
            if action == "stop":
                print(green("stopped %s" % TUNNEL_LABEL))

        if action in ("start", "restart"):
            if not (os.path.isfile(NGROK_BIN) and os.access(NGROK_BIN, os.X_OK)):
                return self.fail("ngrok not executable: %s" % NGROK_BIN)
            plist_path = write_service_plist(
                TUNNEL_LABEL, [NGROK_BIN, "http", str(WEB_PORT), "--log=stdout"],
                os.path.join(WEB_LOGS_DIR, "cjobtunnel.log"), extra_env={"HOME": HOME})
            ok, error = service_bootstrap(TUNNEL_LABEL, plist_path)
            if not ok:
                return self.fail(error)
            print(green("started %s" % TUNNEL_LABEL))

        if action == "status":
            loaded = agent_loaded(TUNNEL_LABEL)
            print("%s  %s" % (TUNNEL_LABEL, green("loaded") if loaded else dim("not loaded")))
            data = http_get_json("http://127.0.0.1:4040/api/tunnels")
            tunnels = (data or {}).get("tunnels") or []
            https = [t for t in tunnels if t.get("proto") == "https"]
            if https:
                print("  %s %s" % (green("public URL:"), bold(https[0].get("public_url", "?"))))
            elif tunnels:
                print("  %s %s" % (green("public URL:"), bold(tunnels[0].get("public_url", "?"))))
            else:
                print("  %s" % (dim("no active tunnel found on 127.0.0.1:4040")
                                if loaded else red("not running")))
                if loaded:
                    self.rc = 1

