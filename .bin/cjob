CONFIG_START = re.compile(r"^#\s*CONFIG\b")
CONFIG_END = re.compile(r"^#\s*END CONFIG\b")
ASSIGN = re.compile(r"^([A-Z][A-Z0-9_]*)=(.*)$")

CONFIG_KEYS = [
    "JOB_NAME", "REPO_DIR", "EXTRA_DIRS", "MODEL", "PERMISSION_MODE",
    "MAX_TURNS", "MAX_BUDGET_USD", "ALLOWED_TOOLS", "DISALLOWED_TOOLS",
    "TIMEOUT_SECONDS", "LOG_RETENTION_DAYS", "PATH_EXTRA", "TOKEN_FILE",
    "CLAUDE_BIN",
]

CONFIG_KEYS_JIVA = [
    "JOB_NAME", "REPO_DIR", "JIVA_MAX_ITERATIONS", "JIVA_CONFIG_FILE",
    "JIVA_DIRECTIVE_FILE", "JIVA_INPUT_PRICE_PER_1M", "JIVA_OUTPUT_PRICE_PER_1M",
    "TIMEOUT_SECONDS", "LOG_RETENTION_DAYS", "PATH_EXTRA", "JIVA_BIN",
]


def config_keys_for(cfg_or_meta):
    """Which CONFIG_KEYS list to show, based on the job's RUNNER."""
    runner = cfg_or_meta.get("RUNNER") or cfg_or_meta.get("runner") or "claude"
    return CONFIG_KEYS_JIVA if runner == "jiva" else CONFIG_KEYS


def _split_value(text):
    try:
        parts = shlex.split(text, comments=True)
    except ValueError:
        parts = [text.strip()]
    return parts


def parse_run_sh(path):
    """Parse the CONFIG block out of a run.sh. Source of truth is run.sh."""
    cfg = {}
    try:
        with open(path) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return cfg
    inside = False
    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if not inside:
            if CONFIG_START.match(stripped):
                inside = True
            i += 1
            continue
        if CONFIG_END.match(stripped):
            break
        m = ASSIGN.match(stripped)
        if m:
            key, rhs = m.group(1), m.group(2)
            if rhs.lstrip().startswith("("):
                buf = rhs.lstrip()[1:]
                while ")" not in buf and i + 1 < len(lines):
                    i += 1
                    buf += " " + lines[i]
                buf = buf.split(")", 1)[0]
                cfg[key] = _split_value(buf)
            else:
                vals = _split_value(rhs)
                cfg[key] = vals[0] if vals else ""
        i += 1
    return cfg


def cfg_int(cfg, key, default=0):
    try:
        return int(str(cfg.get(key, default)).strip())
    except (TypeError, ValueError):
        return default


def cfg_num(cfg, key, default=0):
    try:
        v = float(str(cfg.get(key, default)).strip())
        return int(v) if v == int(v) else v
    except (TypeError, ValueError):
        return default


def auto_mode_supported(model):
    """True / False / None (unknown model)."""
    m = (model or "").strip()
    if m in AUTO_SUPPORTED:
        return True
    if m in MODEL_ALIASES:
        return None
    if m.startswith("claude-fable-"):
        return True
    if m.startswith("claude-haiku"):
        return False
    mm = re.match(r"^claude-(opus|sonnet)-(\d+)(?:-(\d+))?", m)
    if mm:
        major = int(mm.group(2))
        minor = int(mm.group(3) or 0)
        if major >= 5:
            return True
        return (major, minor) >= (4, 6)
    return None


# ─────────────────────────── schedules ────────────────────────────────

DAY_KEYS = {
    "sun": 0, "sunday": 0, "mon": 1, "monday": 1, "tue": 2, "tues": 2,
    "tuesday": 2, "wed": 3, "weds": 3, "wednesday": 3, "thu": 4, "thur": 4,
    "thurs": 4, "thursday": 4, "fri": 5, "friday": 5, "sat": 6, "saturday": 6,
}
DAY_NAMES = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
SCHEDULE_HELP = (
    "specs:  hourly | hourly :07 | daily 03:00 | daily 03:00,15:00 | "
    "weekdays 09:30 | weekends 10:00 | mon,thu 07:00"
)


def _parse_times(text):
    times = []
    for chunk in text.split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        m = re.match(r"^(\d{1,2}):(\d{2})$", chunk)
        if not m:
            raise ValueError("bad time %r (want HH:MM)" % chunk)
        hour, minute = int(m.group(1)), int(m.group(2))
        if not (0 <= hour <= 23 and 0 <= minute <= 59):
            raise ValueError("time out of range: %r" % chunk)
        times.append((hour, minute))
    if not times:
        raise ValueError("no time given")
    return times


def parse_schedule(spec):
    """-> (canonical_spec, [StartCalendarInterval dicts])"""
    toks = (spec or "").strip().split()
    if not toks:
        raise ValueError("empty schedule. " + SCHEDULE_HELP)
    when = toks[0].lower()
    rest = "".join(toks[1:])

    if when == "hourly":
        minute = 0
        if rest:
            m = re.match(r"^:?(\d{1,2})$", rest)
            if not m:
                raise ValueError("hourly takes an optional minute, e.g. `hourly :07`")
            minute = int(m.group(1))
            if not 0 <= minute <= 59:
                raise ValueError("minute out of range: %s" % minute)
        canon = "hourly" if minute == 0 else "hourly :%02d" % minute
        return canon, [{"Minute": minute}]

    times = _parse_times(rest)
    times_s = ",".join("%02d:%02d" % t for t in times)

    if when == "daily":
        return "daily %s" % times_s, [{"Hour": h, "Minute": m} for h, m in times]

    if when == "weekdays":
        days = [1, 2, 3, 4, 5]
        canon_when = "weekdays"
    elif when == "weekends":
        days = [0, 6]
        canon_when = "weekends"
    else:
        days = []
        for part in when.split(","):
            part = part.strip()
            if part not in DAY_KEYS:
                raise ValueError("unknown day %r. %s" % (part, SCHEDULE_HELP))
            wd = DAY_KEYS[part]
            if wd not in days:
                days.append(wd)
        if not days:
            raise ValueError("no days given. " + SCHEDULE_HELP)
        canon_when = ",".join(DAY_NAMES[d].lower() for d in sorted(days))

    entries = [
        {"Weekday": d, "Hour": h, "Minute": m}
        for d in sorted(days) for h, m in times
    ]
    return "%s %s" % (canon_when, times_s), entries


def describe_schedule(meta):
    sched = (meta or {}).get("schedule") or {}
    spec = sched.get("spec")
    if not spec:
        return dim("unscheduled")
    if spec == "hourly":
        return "hourly at :00"
    return spec


def render_calendar(entries):
    def one(entry, indent):
        pad = " " * indent
        out = [pad + "<dict>"]
        for key in ("Weekday", "Hour", "Minute"):
            if key in entry:
                out.append("%s  <key>%s</key><integer>%d</integer>"
                           % (pad, key, entry[key]))
        out.append(pad + "</dict>")
        return out

    if len(entries) == 1:
        return "\n".join(one(entries[0], 2))
    lines = ["  <array>"]
    for entry in entries:
        lines.extend(one(entry, 4))
    lines.append("  </array>")
    return "\n".join(lines)


