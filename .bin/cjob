# ─────────────────────────── job model ────────────────────────────────

class Job:
    def __init__(self, name):
        self.name = name
        self.dir = os.path.join(AGENTS_DIR, name)

    # paths
    @property
    def run_sh(self):
        return os.path.join(self.dir, "run.sh")

    @property
    def prompt(self):
        return os.path.join(self.dir, "prompt.md")

    @property
    def job_json(self):
        return os.path.join(self.dir, "job.json")

    @property
    def state_dir(self):
        return os.path.join(self.dir, "state")

    @property
    def logs_dir(self):
        return os.path.join(self.dir, "logs")

    @property
    def label(self):
        return LABEL_PREFIX + self.name

    @property
    def plist(self):
        return os.path.join(LAUNCH_AGENTS, self.label + ".plist")

    # data
    def config(self):
        return parse_run_sh(self.run_sh)

    def meta(self, sync=True):
        meta = {}
        try:
            with open(self.job_json) as fh:
                meta = json.load(fh)
        except (OSError, ValueError):
            meta = {}
        if not sync:
            return meta
        cfg = self.config()
        runner = cfg.get("RUNNER") or "claude"
        if runner == "jiva":
            derived = {
                "name": self.name,
                "runner": "jiva",
                "repo_dir": cfg.get("REPO_DIR", ""),
                "timeout_seconds": cfg_int(cfg, "TIMEOUT_SECONDS"),
                "log_retention_days": cfg_int(cfg, "LOG_RETENTION_DAYS"),
                "jiva_max_iterations": cfg_int(cfg, "JIVA_MAX_ITERATIONS", 30),
                "jiva_config_file": cfg.get("JIVA_CONFIG_FILE") or DEFAULT_JIVA_CONFIG_FILE,
                "jiva_directive_file": cfg.get("JIVA_DIRECTIVE_FILE", ""),
                "jiva_input_price_per_1m": cfg_num(cfg, "JIVA_INPUT_PRICE_PER_1M", None),
                "jiva_output_price_per_1m": cfg_num(cfg, "JIVA_OUTPUT_PRICE_PER_1M", None),
                "jiva_bin": cfg.get("JIVA_BIN") or DEFAULT_JIVA_BIN,
            }
        else:
            derived = {
                "name": self.name,
                "runner": "claude",
                "repo_dir": cfg.get("REPO_DIR", ""),
                "model": cfg.get("MODEL", ""),
                "permission_mode": cfg.get("PERMISSION_MODE", ""),
                "max_turns": cfg_int(cfg, "MAX_TURNS"),
                "max_budget_usd": cfg_num(cfg, "MAX_BUDGET_USD"),
                "timeout_seconds": cfg_int(cfg, "TIMEOUT_SECONDS"),
                "log_retention_days": cfg_int(cfg, "LOG_RETENTION_DAYS"),
                "extra_dirs": cfg.get("EXTRA_DIRS", []),
                "allowed_tools": cfg.get("ALLOWED_TOOLS", ""),
                "disallowed_tools": cfg.get("DISALLOWED_TOOLS", ""),
                "token_file": cfg.get("TOKEN_FILE", DEFAULT_TOKEN_FILE),
                "claude_bin": cfg.get("CLAUDE_BIN", DEFAULT_CLAUDE_BIN),
            }
        # run.sh wins for everything it owns; job.json owns only enabled/schedule.
        changed = any(meta.get(k) != v for k, v in derived.items())
        meta.update(derived)
        meta.setdefault("enabled", False)
        meta.setdefault("schedule", {})
        meta.setdefault("created", None)
        if changed and os.path.isdir(self.dir):
            self.write_meta(meta)
        return meta

    def write_meta(self, meta):
        meta["synced_from_run_sh"] = datetime.datetime.now().isoformat(timespec="seconds")
        tmp = self.job_json + ".tmp"
        try:
            with open(tmp, "w") as fh:
                json.dump(meta, fh, indent=2, sort_keys=True)
                fh.write("\n")
            os.replace(tmp, self.job_json)
        except OSError as exc:
            err("cannot write %s: %s" % (self.job_json, exc))

    def last_run(self):
        try:
            with open(os.path.join(self.state_dir, "last-run.json")) as fh:
                return json.load(fh)
        except (OSError, ValueError):
            return None

    def log_dates(self):
        try:
            names = os.listdir(self.logs_dir)
        except OSError:
            return []
        dates = [n for n in names
                 if re.match(r"^\d{4}-\d{2}-\d{2}$", n)
                 and os.path.isdir(os.path.join(self.logs_dir, n))]
        return sorted(dates)

    def runs_on(self, date):
        path = os.path.join(self.logs_dir, date)
        try:
            names = sorted(n for n in os.listdir(path) if n.endswith(".log"))
        except OSError:
            return []
        out = []
        for name in names:
            out.append(read_run(os.path.join(path, name), date, name[:-4]))
        return out

    def recent_runs(self, limit=5):
        out = []
        for date in reversed(self.log_dates()):
            out = self.runs_on(date) + out
            if len(out) >= limit:
                break
        return out[-limit:] if limit else out

    def locked_pid(self):
        try:
            with open(os.path.join(self.state_dir, "run.lock", "pid")) as fh:
                pid = int(fh.read().strip())
        except (OSError, ValueError):
            return None
        try:
            os.kill(pid, 0)
            return pid
        except OSError:
            return None  # stale


FOOTER_RE = re.compile(r"^cjob\.([a-z_]+)=(.*)$", re.M)


def read_run(log_path, date, hhmmss):
    """Pull one run's summary from its log footer (+ result.json fallback)."""
    rec = {
        "date": date, "time": hhmmss.replace("-", ":"), "log": log_path,
        "exit_code": None, "duration_seconds": None, "total_cost_usd": None,
        "num_turns": None, "is_error": None, "killed": False,
        "session_id": None, "skipped": False, "incomplete": False,
    }
    try:
        size = os.path.getsize(log_path)
        with open(log_path, errors="replace") as fh:
            if size > 16384:
                fh.seek(size - 16384)
            tail = fh.read()
    except OSError:
        return rec

    found = {}
    for m in FOOTER_RE.finditer(tail):
        found[m.group(1)] = m.group(2).strip()

    if found:
        rec["exit_code"] = _int_or_none(found.get("exit_code"))
        rec["duration_seconds"] = _int_or_none(found.get("duration_seconds"))
        rec["num_turns"] = _int_or_none(found.get("num_turns"))
        rec["total_cost_usd"] = _float_or_none(found.get("total_cost_usd"))
        rec["is_error"] = found.get("is_error") == "true"
        rec["killed"] = found.get("killed_by_watchdog") == "yes"
        rec["session_id"] = found.get("session_id") or None
    elif "SKIPPED: already running" in tail:
        rec["skipped"] = True
        rec["exit_code"] = 0
    elif "FATAL:" in tail:
        rec["exit_code"] = 78
        rec["is_error"] = True
    else:
        # Header but no footer: either in flight right now, or the run died
        # before it could write one. Age tells them apart.
        try:
            fresh = (time.time() - os.path.getmtime(log_path)) < 300
        except OSError:
            fresh = False
        if not fresh:
            rec["incomplete"] = True
            rec["is_error"] = True

    if rec["total_cost_usd"] is None:
        data = read_result(log_path[:-4] + ".result.json")
        if data:
            rec["total_cost_usd"] = data.get("total_cost_usd")
            rec["num_turns"] = data.get("num_turns")
            if rec["is_error"] is None:
                rec["is_error"] = bool(data.get("is_error"))
    return rec


def read_result(path):
    try:
        with open(path, errors="replace") as fh:
            text = fh.read()
    except OSError:
        return None
    if not text.strip():
        return None
    try:
        data = json.loads(text)
        return data if isinstance(data, dict) else None
    except ValueError:
        for line in reversed(text.strip().splitlines()):
            try:
                data = json.loads(line)
            except ValueError:
                continue
            if isinstance(data, dict):
                return data
    return None


def _int_or_none(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _float_or_none(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def list_jobs():
    """A dir under ~/claude-jobs/.agents is a job iff no leading dot and has job.json."""
    try:
        names = sorted(os.listdir(AGENTS_DIR))
    except OSError:
        return []
    out = []
    for name in names:
        if name.startswith("."):
            continue
        path = os.path.join(AGENTS_DIR, name)
        if os.path.isdir(path) and os.path.isfile(os.path.join(path, "job.json")):
            out.append(Job(name))
    return out


def get_job(name):
    if not name:
        err("a job name is required")
        return None
    job = Job(name)
    if not os.path.isfile(job.job_json):
        err("no such job: %s  (try `ls`)" % name)
        return None
    return job


def cli_state():
    try:
        with open(CLI_STATE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_cli_state(state):
    os.makedirs(os.path.dirname(CLI_STATE), exist_ok=True)
    tmp = CLI_STATE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, CLI_STATE)


def open_editor(path):
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    if not editor:
        editor = "vi" if sys.stdin.isatty() else ""
    if not editor:
        print("  $EDITOR is unset — edit by hand: %s" % path)
        return 0
    try:
        return subprocess.call(shlex.split(editor) + [path])
    except OSError as exc:
        err("cannot launch editor %r: %s" % (editor, exc))
        print("  edit by hand: %s" % path)
        return 1


def fmt_cost(v):
    return dim("—") if v is None else "$%.4f" % v


def fmt_exit(rec):
    if rec is None:
        return dim("—")
    if rec.get("skipped"):
        return dim("skip")
    if rec.get("incomplete"):
        return red("no footer")
    code = rec.get("exit_code")
    if code is None:
        return yellow("running?")
    if rec.get("killed"):
        return red("%d kill" % code)
    if code == 0 and not rec.get("is_error"):
        return green("0")
    return red(str(code) if code else "err")


def fmt_dur(secs):
    if secs is None:
        return dim("—")
    if secs < 90:
        return "%ds" % secs
    return "%dm%02ds" % (secs // 60, secs % 60)


def stripped_env(token_file=None):
    """The environment a scheduled run gets — nothing inherited."""
    env = {
        "PATH": "/Users/abi/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "HOME": HOME,
    }
    if token_file:
        try:
            with open(token_file) as fh:
                # Strip ALL whitespace, not just the ends: a token file written by
                # a wrapping terminal can carry an internal newline, which the API
                # rejects as an invalid Authorization header. run.sh does the same
                # with `tr -d '[:space:]'`.
                token = re.sub(r"\s+", "", fh.read())
            if token:
                env["CLAUDE_CODE_OAUTH_TOKEN"] = token
        except OSError:
            pass
    return env


SECRET_RE = re.compile(r"(sk-ant-[A-Za-z0-9]{4})[A-Za-z0-9_\-]{8,}")


def redact(text):
    """Never echo a credential to the console, even one the API handed back."""
    return SECRET_RE.sub(r"\1...REDACTED", str(text))


