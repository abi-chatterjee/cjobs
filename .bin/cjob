_TTY = sys.stdout.isatty()


def _c(code):
    return (lambda s: "\033[%sm%s\033[0m" % (code, s)) if _TTY else (lambda s: str(s))


bold = _c("1")
dim = _c("2")
red = _c("31")
green = _c("32")
yellow = _c("33")
blue = _c("34")
cyan = _c("36")


def err(msg):
    sys.stderr.write("%s %s\n" % (red("error:"), msg))


def warn(msg):
    print("%s %s" % (yellow("warn:"), msg))


def table(rows, headers):
    if not rows:
        return
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(_plain(cell)))
    line = "  ".join(bold(h.ljust(widths[i])) for i, h in enumerate(headers))
    print(line)
    print(dim("  ".join("-" * w for w in widths)))
    for row in rows:
        print("  ".join(_pad(c, widths[i]) for i, c in enumerate(row)))


_ANSI = re.compile(r"\033\[[0-9;]*m")


def _plain(s):
    return _ANSI.sub("", str(s))


def _pad(s, width):
    s = str(s)
    return s + " " * max(0, width - len(_plain(s)))


def _wrap_value(value, width=78):
    """Break a long config value at commas so `show` stays readable."""
    text = str(value)
    if len(_plain(text)) <= width:
        return [text]
    chunks, current = [], ""
    for part in text.split(","):
        candidate = part if not current else current + "," + part
        if len(candidate) > width and current:
            chunks.append(current + ",")
            current = part
        else:
            current = candidate
    if current:
        chunks.append(current)
    return chunks or [text]


# ─────────────────────────── process helpers ──────────────────────────

def run(argv, env=None, cwd=None, timeout=None):
    """Never shell=True. Returns (rc, stdout, stderr)."""
    try:
        proc = subprocess.run(
            argv, capture_output=True, text=True, env=env, cwd=cwd, timeout=timeout
        )
        return proc.returncode, proc.stdout, proc.stderr
    except FileNotFoundError:
        return 127, "", "%s: command not found" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "", "timed out after %ss" % timeout


def git_info(repo_dir):
    if not os.path.isdir(repo_dir):
        return None
    rc, out, _ = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo_dir)
    if rc != 0:
        return None
    branch = out.strip()
    _, sha, _ = run(["git", "rev-parse", "--short", "HEAD"], cwd=repo_dir)
    _, status, _ = run(["git", "status", "--porcelain"], cwd=repo_dir)
    return {"branch": branch, "sha": sha.strip(), "dirty": bool(status.strip())}


